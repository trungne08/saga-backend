# Local-only configuration. Copy to .env.local; never commit real credentials.
# Never copy localhost URLs or tunnel URLs from this file into Railway.
SPRING_PROFILES_ACTIVE=local
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
LOCAL_WEBHOOK_BASE_URL=

FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
AUTH_SUCCESS_REDIRECT_URI=http://localhost:3000
AUTH_LOGOUT_REDIRECT_URI=http://localhost:3000

DATABASE_JDBC_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
MONGO_URI=
MONGO_DATABASE=saga_db

COGNITO_ISSUER_URI=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=

# Disabled by default: no provider REST client or provider job is started.
JIRA_INTEGRATION_ENABLED=false
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_CALLBACK_URL=http://localhost:8080/api/integrations/jira/callback
# Leave blank unless LOCAL_WEBHOOK_BASE_URL is configured. The application then
# derives <LOCAL_WEBHOOK_BASE_URL>/api/webhooks/jira.
JIRA_WEBHOOK_PUBLIC_URL=
JIRA_SCOPES=read:me read:jira-user read:jira-work offline_access manage:jira-webhook

GITHUB_INTEGRATION_ENABLED=false
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
GITHUB_PERSONAL_CALLBACK_URL=http://localhost:8080/api/me/integrations/github/callback
GITHUB_PROJECT_CALLBACK_URL=http://localhost:8080/api/integrations/github/project/callback
GITHUB_SETUP_URL=http://localhost:8080/api/integrations/github/setup
# Leave blank unless LOCAL_WEBHOOK_BASE_URL is configured. The application then
# derives <LOCAL_WEBHOOK_BASE_URL>/api/webhooks/github.
GITHUB_WEBHOOK_PUBLIC_URL=

INTEGRATION_TOKEN_ENCRYPTION_KEY=
INTEGRATION_TOKEN_ENCRYPTION_KEY_ID=primary
INTEGRATION_RECONCILIATION_ENABLED=false

FLYWAY_ENABLED=false
FLYWAY_BASELINE_ON_MIGRATE=false

# Optional local demo integration seed. Set only after this Cognito user has
# signed in once and therefore already has a Student profile in SAGA.
LOCAL_DEMO_SEED_ENABLED=false
LOCAL_DEMO_LEADER_COGNITO_SUB=
