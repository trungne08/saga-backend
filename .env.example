# Copy to .env for local development only. Never commit .env.
# Values below are safe placeholders: replace every <...> value before use.

# Required application/runtime configuration
SPRING_PROFILES_ACTIVE=<prod-or-local>
PORT=<8080-or-platform-port>
PUBLIC_BASE_URL=<https-public-backend-origin>
FRONTEND_ORIGINS=<https-frontend-origin>
AUTH_SUCCESS_REDIRECT_URI=<https-frontend-origin-after-login>
AUTH_LOGOUT_REDIRECT_URI=<https-frontend-origin-after-logout>
INTEGRATION_CALLBACK_REDIRECT_URI=<https-frontend-origin-integration-callback>
INTEGRATION_CALLBACK_RESULT_TTL=PT5M
SESSION_COOKIE_SECURE=<true-or-false>
SESSION_COOKIE_SAME_SITE=<none-or-lax>
# Set both to true on Railway only when Swagger should be public.
SPRINGDOC_API_DOCS_ENABLED=<true-or-false>
SPRINGDOC_SWAGGER_UI_ENABLED=<true-or-false>
# Legacy compatibility only; prefer the two SPRINGDOC_* variables above.
SWAGGER_ENABLED=<true-or-false>

# MySQL: use DATABASE_* on Railway. AIVEN_* are legacy local fallbacks.
DATABASE_JDBC_URL=<mysql-jdbc-connection-string>
DATABASE_USERNAME=<mysql-username>
DATABASE_PASSWORD=<mysql-password>
AIVEN_JDBC_URL=<legacy-mysql-jdbc-connection-string>
AIVEN_DB_USERNAME=<legacy-mysql-username>
AIVEN_DB_PASSWORD=<legacy-mysql-password>
FLYWAY_ENABLED=<true-or-false>
FLYWAY_BASELINE_ON_MIGRATE=<true-or-false>

# MongoDB Atlas
MONGO_URI=<mongodb-connection-string>
MONGO_DATABASE=<mongodb-database-name>
MONGO_HEALTH_TIMEOUT=<iso-8601-duration>

# AWS Cognito / OAuth2
COGNITO_ISSUER_URI=<cognito-issuer-uri>
COGNITO_CLIENT_ID=<cognito-client-id>
COGNITO_CLIENT_SECRET=<cognito-client-secret>
COGNITO_DOMAIN=<cognito-domain>

# Student Course Invitation through Gmail REST API (all five required to enable delivery)
GMAIL_API_CLIENT_ID=<gmail-oauth-client-id>
GMAIL_API_CLIENT_SECRET=<gmail-oauth-client-secret>
GMAIL_API_REFRESH_TOKEN=<gmail-offline-refresh-token-with-gmail-send-scope>
GMAIL_API_SENDER_EMAIL=<authorized-gmail-sender-address>
GMAIL_API_SENDER_NAME=<sender-display-name>
STUDENT_INVITATION_LOGIN_URL=<absolute-http-or-https-login-url>

# Integration credential encryption (required whenever Jira or GitHub is enabled)
INTEGRATION_TOKEN_ENCRYPTION_KEY=<strong-random-encryption-key>
INTEGRATION_TOKEN_ENCRYPTION_KEY_ID=<key-identifier>
INTEGRATION_TOKEN_ENCRYPTION_PREVIOUS_KEYS=<optional-previous-key-ring>
INTEGRATION_OAUTH_STATE_TTL=<iso-8601-duration>
INTEGRATION_HTTP_CONNECT_TIMEOUT=<iso-8601-duration>
INTEGRATION_HTTP_READ_TIMEOUT=<iso-8601-duration>

# Jira OAuth and webhook (required when JIRA_INTEGRATION_ENABLED=true)
JIRA_INTEGRATION_ENABLED=<true-or-false>
JIRA_CLIENT_ID=<jira-oauth-client-id>
JIRA_CLIENT_SECRET=<jira-oauth-client-secret>
JIRA_AUTHORIZATION_URL=<jira-authorization-url>
JIRA_TOKEN_URL=<jira-token-url>
JIRA_API_BASE_URL=<jira-api-base-url>
JIRA_CALLBACK_URL=<https-public-backend-origin-api-integrations-jira-callback>
JIRA_WEBHOOK_PUBLIC_URL=<https-public-backend-origin-api-webhooks-jira>
JIRA_SCOPES=<space-separated-jira-scopes>
JIRA_TIME_ZONE=<iana-time-zone>

# GitHub App and OAuth (required when GITHUB_INTEGRATION_ENABLED=true)
GITHUB_INTEGRATION_ENABLED=<true-or-false>
GITHUB_APP_ID=<github-app-id>
GITHUB_CLIENT_ID=<github-oauth-client-id>
GITHUB_CLIENT_SECRET=<github-oauth-client-secret>
GITHUB_PRIVATE_KEY=<base64-or-escaped-pem-private-key>
GITHUB_WEBHOOK_SECRET=<github-webhook-secret>
GITHUB_APP_SLUG=<github-app-slug>
GITHUB_API_BASE_URL=<github-api-base-url>
GITHUB_WEB_BASE_URL=<github-web-base-url>
GITHUB_PERSONAL_CALLBACK_URL=<https-public-backend-origin-api-me-integrations-github-callback>
GITHUB_PROJECT_CALLBACK_URL=<https-public-backend-origin-api-integrations-github-project-callback>
GITHUB_SETUP_URL=<https-public-backend-origin-api-integrations-github-setup>
GITHUB_WEBHOOK_PUBLIC_URL=<https-public-backend-origin-api-webhooks-github>

# Optional schedulers and local-only support
INTEGRATION_RECONCILIATION_ENABLED=<true-or-false>
INTEGRATION_RECONCILIATION_DELAY_MS=<milliseconds>
INTEGRATION_OVERLAP_WINDOW=<iso-8601-duration>
SYNC_JOB_STALE_AFTER=<iso-8601-duration>
STALE_SYNC_JOB_RECOVERY_DELAY_MS=<milliseconds>
LOCAL_WEBHOOK_BASE_URL=<local-https-tunnel-origin>
LOCAL_DEMO_SEED_ENABLED=<true-or-false>
LOCAL_DEMO_LEADER_COGNITO_SUB=<local-demo-user-subject>

# Railway build environment, set in Railway rather than a committed .env.
RAILPACK_JDK_VERSION=<25>
