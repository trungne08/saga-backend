# Railway runtime
SPRING_PROFILES_ACTIVE=prod
# Railway injects PORT automatically. Keep 8080 only for a local copy of this file.
PORT=8080
PUBLIC_BASE_URL=
FRONTEND_ORIGINS=
AUTH_SUCCESS_REDIRECT_URI=
AUTH_LOGOUT_REDIRECT_URI=
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=none
SWAGGER_ENABLED=false

# MySQL and MongoDB
DATABASE_JDBC_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
MONGO_URI=
MONGO_DATABASE=saga_db

# Amazon Cognito
COGNITO_ISSUER_URI=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=

# AES-256-GCM token encryption. The active key is exactly 32 random bytes,
# Base64-encoded. Previous keys are decrypt-only: old-id:BASE64,older-id:BASE64
INTEGRATION_TOKEN_ENCRYPTION_KEY=
INTEGRATION_TOKEN_ENCRYPTION_KEY_ID=primary
INTEGRATION_TOKEN_ENCRYPTION_PREVIOUS_KEYS=

# Atlassian OAuth 2.0 (3LO). Personal and project flows share this callback;
# their server-side, one-time OAuth state is the only flow discriminator.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_CALLBACK_URL=${PUBLIC_BASE_URL}/api/integrations/jira/callback
JIRA_WEBHOOK_PUBLIC_URL=${PUBLIC_BASE_URL}/api/webhooks/jira
JIRA_SCOPES=read:me read:jira-user read:jira-work offline_access manage:jira-webhook
JIRA_AUTHORIZATION_URL=https://auth.atlassian.com/authorize
JIRA_TOKEN_URL=https://auth.atlassian.com/oauth/token
JIRA_API_BASE_URL=https://api.atlassian.com

# GitHub App
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
GITHUB_PERSONAL_CALLBACK_URL=${PUBLIC_BASE_URL}/api/me/integrations/github/callback
GITHUB_PROJECT_CALLBACK_URL=${PUBLIC_BASE_URL}/api/integrations/github/project/callback
GITHUB_SETUP_URL=${PUBLIC_BASE_URL}/api/integrations/github/setup
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_WEB_BASE_URL=https://github.com

# First migration of a non-empty legacy schema: temporarily set both values
# to true for one controlled, single-replica deployment. After V2 succeeds,
# immediately restore both values to false.
FLYWAY_ENABLED=false
FLYWAY_BASELINE_ON_MIGRATE=false

# Automatic durable webhook processing and reconciliation remain enabled.
INTEGRATION_RECONCILIATION_ENABLED=true
INTEGRATION_RECONCILIATION_DELAY_MS=900000
INTEGRATION_OVERLAP_WINDOW=PT5M
INTEGRATION_OAUTH_STATE_TTL=PT10M
INTEGRATION_HTTP_CONNECT_TIMEOUT=PT3S
INTEGRATION_HTTP_READ_TIMEOUT=PT10S
